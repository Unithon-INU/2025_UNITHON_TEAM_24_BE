# 데이터베이스 URL (사용할 DB에 맞게 수정)
# 예: PostgreSQL: DATABASE_URL="postgresql://user:password@host:port/database"
# 예: SQLite (개발용): DATABASE_URL="sqlite:///./test.db"
DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# Google Cloud 및 Firebase 설정
GOOGLE_PLACES_API_KEY="YOUR_GOOGLE_PLACES_API_KEY"

# Firebase Admin SDK 서비스 계정 키 파일 경로 (JSON)
GOOGLE_APPLICATION_CREDENTIALS="./serviceAccountKey.json"

# JWT 설정
# 실제 배포시 반드시 복잡하고 안전한 문자열로 변경하세요!
SECRET_KEY='your-secret-key-here'
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60 # 예: 60분